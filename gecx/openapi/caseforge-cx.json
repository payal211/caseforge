{
  "openapi": "3.1.0",
  "info": {
    "title": "CaseForge CX channel",
    "description": "Shared multi-agent investigation platform with pluggable domain packs.",
    "version": "0.1.0"
  },
  "paths": {
    "/cx/accounts/{account_id}/transactions": {
      "get": {
        "tags": [
          "cx (customer channel)"
        ],
        "summary": "Recent Transactions",
        "description": "Recent transactions for the authenticated account, newest first (customer-safe fields only).",
        "operationId": "recent_transactions_cx_accounts__account_id__transactions_get",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 8,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionOut"
                  },
                  "title": "Response Recent Transactions Cx Accounts  Account Id  Transactions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cx/disputes": {
      "post": {
        "tags": [
          "cx (customer channel)"
        ],
        "summary": "Open Dispute",
        "description": "Open a dispute. Runs the full CaseForge investigation; result is held for human approval.",
        "operationId": "open_dispute_cx_disputes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisputeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisputeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cx/disputes/{reference}": {
      "get": {
        "tags": [
          "cx (customer channel)"
        ],
        "summary": "Dispute Status",
        "description": "Customer-safe status. The notification text is released only after a human decision.",
        "operationId": "dispute_status_cx_disputes__reference__get",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Reference"
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Account Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisputeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionIn": {
        "properties": {
          "reviewer": {
            "type": "string",
            "title": "Reviewer"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          },
          "override_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Override Action"
          }
        },
        "type": "object",
        "required": [
          "reviewer",
          "outcome"
        ],
        "title": "DecisionIn"
      },
      "DisputeIn": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id",
            "description": "Authenticated account (from the CX session, not from chat text)."
          },
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "customer_statement": {
            "type": "string",
            "maxLength": 2000,
            "title": "Customer Statement",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "transaction_id"
        ],
        "title": "DisputeIn"
      },
      "DisputeOut": {
        "properties": {
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "status": {
            "type": "string",
            "enum": [
              "under_review",
              "resolved",
              "specialist_follow_up"
            ],
            "title": "Status"
          },
          "customer_message": {
            "type": "string",
            "title": "Customer Message"
          }
        },
        "type": "object",
        "required": [
          "reference",
          "status",
          "customer_message"
        ],
        "title": "DisputeOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewCase": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          }
        },
        "type": "object",
        "required": [
          "domain",
          "subject_id"
        ],
        "title": "NewCase"
      },
      "TransactionOut": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "merchant": {
            "type": "string",
            "title": "Merchant"
          },
          "country": {
            "type": "string",
            "title": "Country"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "timestamp",
          "amount",
          "merchant",
          "country"
        ],
        "title": "TransactionOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ]
}